# ResQNet environment configuration template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
# SQLite (development default):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (intended project database) - switch to this when Postgres is ready:
# DATABASE_URL=postgres://resqnet_user:your_password@localhost:5432/resqnet

# --- Firebase authentication -------------------------------------------
# Web config: Firebase console -> Project settings -> General -> Your apps
# -> Web app -> SDK setup and configuration -> Config.
# These are NOT secrets. They ship in every Firebase web app and identify the
# project; security comes from this server verifying ID tokens.
FIREBASE_API_KEY=AIzaSyAlr29P2IqeQofn5WfkSDaKzkXuZbZQSpw
FIREBASE_AUTH_DOMAIN=resqnet-1f393.firebaseapp.com
FIREBASE_PROJECT_ID=resqnet-1f393
FIREBASE_APP_ID=1:253190384007:web:a3a4db7485e5ea2f764b22
FIREBASE_STORAGE_BUCKET=resqnet-1f393.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID=253190384007

# Service account: Firebase console -> Project settings -> Service accounts
# -> Generate new private key. This file IS a secret - keep it out of git.
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json
# Alternative for hosts that only provide environment variables:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}

# In the Firebase console, enable under Authentication -> Sign-in method:
#   - Email/Password   (citizens and field officers)
#   - Google           (citizens only; the server rejects it for staff accounts)
# And add your domain under Authentication -> Settings -> Authorized domains.

# --- File uploads -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# --- Security (production only) ----------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
