# Environment / secrets
# .env holds SECRET_KEY and database credentials. It must NEVER be committed —
# anything pushed to a public repo stays in the history even if deleted later.
.env
.env.*
!.env.example
*.pem
*.key

# Firebase service account credentials — a private key. Never commit.
secrets/
*service-account*.json
firebase-adminsdk*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Django
db.sqlite3
db.sqlite3-journal
# Clones created by `manage.py test --parallel`; normally removed on exit, but
# left behind if the run is interrupted.
default_*.sqlite3
test_*.sqlite3
/media/
/staticfiles/
*.log
*.err
server.log
server.err

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
